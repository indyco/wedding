# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# HTTP port the app listens on
PORT=3000

# Interface to bind. Defaults to 127.0.0.1 so only the local machine — i.e.
# cloudflared running alongside the app — can connect. Set 0.0.0.0 ONLY if the
# tunnel runs on a different host, and list that host in TRUSTED_PROXY_IPS.
# BIND_HOST=127.0.0.1

# Peers whose forwarding headers (CF-Connecting-IP, X-Forwarded-For) are trusted,
# comma-separated. Defaults to 127.0.0.1,::1. Requests from anywhere else are
# rate-limited by their real socket address, so the headers can't be forged to
# win a fresh rate-limit bucket per request.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# development | production
# `production` enables secure (HTTPS-only) session cookies — set it when running
# behind Cloudflare. Leaving it as `development` on a real deployment sends the
# admin session cookie WITHOUT the Secure flag and skips the SESSION_SECRET
# strength check; the app warns at startup if it spots that combination.
NODE_ENV=development

# Secret used to sign session cookies. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# First-run admin bootstrap. The admin account is created once from these values on first start.
# Credentials can be changed later in the dashboard (or via `npm run reset-admin`).
#
# PREFERRED: leave ADMIN_PASSWORD unset. A random password is then generated and
# printed once to the startup log. The placeholder below is visible to anyone
# reading this public repo, so never deploy with it as-is.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Resend (https://resend.com): create an API key and verify your sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The From address must use a domain you've verified in Resend.
EMAIL_FROM=The Happy Couple <rsvp@yourdomain.tld>

# Public base URL used to build links inside emails (confirmation / edit-your-RSVP).
# Keep as localhost during development; set to the real https URL at the very end.
APP_BASE_URL=http://localhost:3000

# When RSVPs close. After this moment the guest pages stop accepting lookups and
# submissions, and every previously-emailed edit link stops working — which is
# what bounds how long those links stay valid. Leave unset and nothing expires.
# A bare YYYY-MM-DD means the END of that day, UTC; use a full ISO 8601
# timestamp (e.g. 2026-09-01T23:59:59-05:00) to pin a local time.
RSVP_DEADLINE=2026-09-01

# Optional: override the SQLite database location (defaults to ./data/wedding.db)
# DB_PATH=./data/wedding.db
